# ── Database ──────────────────────────────────────────
POSTGRES_URL=postgresql://admin:secret@localhost:5433/rag_db
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=secretpassword

# ── AI ────────────────────────────────────────────────
# Ollama must be running locally and the model must already be downloaded.
LLM_PROVIDER=ollama
# Local-only evidence verification (no cloud fallback)
EVIDENCE_LOCAL_MODEL=qwen2.5:7b
LLM_MODEL=qwen2.5:7b

OLLAMA_BASE_URL=http://localhost:11434
# Minimum normalized reranker relevance for each named comparison target.
# Provisional operating threshold; calibrate on labeled comparison queries.
COMPARISON_RERANK_MIN_SCORE=0.20
# Cross-encoder candidate pool per query/per comparison target (1-128).
# Larger pools may improve recall but increase latency. Output top_n is separate.
RERANK_CANDIDATES=30
RERANK_GROUP_CANDIDATES=30
# Combined query + passage token limit for both cross-encoder backends (128-512).
# Longer inputs may still be truncated by the tokenizer. Larger limits cost more.
RERANK_MAX_LENGTH=512
# Experimental heuristic skip, not calibrated. Leave disabled for evaluation/use.
# Set 1 only for explicit ablation experiments. force_score still overrides it.
RERANK_EXPERIMENTAL_FAST_COMMIT=0

# Gemini is used only for OCR/vision while LLM_PROVIDER=ollama.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OCR_PROVIDER=gemini
OCR_MODEL=gemini-3.1-flash-lite

# ── Security ──────────────────────────────────────────
# Tạo bằng: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Storage ───────────────────────────────────────────
PDF_UPLOAD_DIR=../data/raw_pdfs
