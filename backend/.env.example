# ── Database ──────────────────────────────────────────
POSTGRES_URL=postgresql://admin:secret@localhost:5433/rag_db
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=secretpassword

# ── AI ────────────────────────────────────────────────
# Key Claude qua proxy Anthropic-compatible (nhận cả Anthropic Messages API
# /v1/messages và OpenAI Chat Completions /v1/chat/completions, route tới Claude).
#
# ANTHROPIC_BASE_URL: chỉ root domain, KHÔNG thêm /v1.
# Ví dụ: https://api.xah.io   (proxy mua từ bên thứ 3 qua ckey.vn)
#
# Model name dùng DẤU CHẤM (vd "claude-opus-4.8") — proxy không chấp nhận dấu gạch ngang.
# Các model khả dụng:
#   - claude-opus-4.8    (mạnh nhất, có thinking mode)
#   - claude-sonnet-4.6  (cân bằng, recommended mặc định)
#   - claude-opus-4.6
# GROQ_API_KEY để trống — backend sẽ dùng ANTHROPIC_* nếu có.
GROQ_API_KEY=
ANTHROPIC_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_BASE_URL=https://api.xah.io
LLM_MODEL=claude-opus-4.8

OLLAMA_BASE_URL=http://localhost:11434

# ── Security ──────────────────────────────────────────
# Tạo bằng: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Storage ───────────────────────────────────────────
PDF_UPLOAD_DIR=../data/raw_pdfs
