'use client';

import { Canvas, ThreeEvent, useFrame } from '@react-three/fiber';
import { OrbitControls, useGLTF, Environment, Billboard } from '@react-three/drei';
import { useState, useRef, Suspense, useEffect } from 'react';
import * as THREE from 'three';

// ── Màu theo từng bộ phận ─────────────────────────────────────────────────────

const PART_COLORS: Record<string, number> = {
  head:            0xf4a261,
  neck:            0xe9c46a,
  chest:           0xe76f51,
  abdomen:         0x2a9d8f,
  pelvis:          0x457b9d,
  left_shoulder:   0x6a9fb5,
  right_shoulder:  0x6a9fb5,
  left_arm:        0x88b4c8,
  right_arm:       0x88b4c8,
  left_leg:        0xa8dadc,
  right_leg:       0xa8dadc,
  left_lower_leg:  0x76c8d0,
  right_lower_leg: 0x76c8d0,
  left_foot:       0x52b6c0,
  right_foot:      0x52b6c0,
};

// ── Bước 1: Phát hiện từ tên mesh trong GLB (nếu có) ─────────────────────────

function classifyByMeshName(object: THREE.Object3D): string | null {
  let obj: THREE.Object3D | null = object;
  while (obj) {
    const n = obj.name.toLowerCase().replace(/[\s\-]/g, '_');
    if (n && !['scene', 'root', 'armature', 'skeleton', 'body', 'mesh', 'object', ''].includes(n)) {
      const isL = n.includes('left')  || n.includes('_l_') || n.endsWith('_l') || n.includes('.l');
      const isR = n.includes('right') || n.includes('_r_') || n.endsWith('_r') || n.includes('.r');

      if (n.includes('head') || n.includes('skull') || n.includes('cranium') || n.includes('face'))
        return 'head';
      if (n.includes('neck') || n.includes('cervical') || n.includes('throat'))
        return 'neck';
      if (n.includes('chest') || n.includes('thorax') || n.includes('ribcage') || n.includes('torso') || n.includes('pectoral') || n.includes('breast'))
        return 'chest';
      if (n.includes('abdomen') || n.includes('belly') || n.includes('stomach') || n.includes('abdominal'))
        return 'abdomen';
      if (n.includes('pelvis') || n.includes('hip') || n.includes('groin') || n.includes('pubic') || n.includes('glute') || n.includes('buttock'))
        return 'pelvis';
      if (n.includes('shoulder') || n.includes('clavicle') || n.includes('scapula') || n.includes('deltoid')) {
        if (isL) return 'left_shoulder'; if (isR) return 'right_shoulder';
      }
      if (n.includes('upper_arm') || n.includes('upperarm') || n.includes('bicep') || n.includes('tricep') ||
          n.includes('forearm') || n.includes('elbow') || n.includes('wrist') || n.includes('hand') ||
          n.includes('finger') || n.includes('thumb')) {
        if (isL) return 'left_arm'; if (isR) return 'right_arm';
      }
      if (n.includes('arm') && !n.includes('forearm')) {
        if (isL) return 'left_arm'; if (isR) return 'right_arm';
      }
      if (n.includes('foot') || n.includes('feet') || n.includes('toe') || n.includes('heel') ||
          n.includes('ankle') || n.includes('tarsus') || n.includes('metatars')) {
        if (isL) return 'left_foot'; if (isR) return 'right_foot';
      }
      if (n.includes('shin') || n.includes('calf') || n.includes('lower_leg') || n.includes('lowerleg') ||
          n.includes('tibia') || n.includes('fibula')) {
        if (isL) return 'left_lower_leg'; if (isR) return 'right_lower_leg';
      }
      if (n.includes('thigh') || n.includes('femur') || n.includes('upper_leg') || n.includes('upperleg') ||
          n.includes('knee') || n.includes('kneecap') || n.includes('patella')) {
        if (isL) return 'left_leg'; if (isR) return 'right_leg';
      }
      if (n.includes('leg') && !n.includes('lower')) {
        if (isL) return 'left_leg'; if (isR) return 'right_leg';
      }
    }
    obj = obj.parent;
  }
  return null;
}

// ── Bước 2: Phân loại theo tỷ lệ cơ thể chuẩn (8-head canon) ────────────────
// ny=0 đáy bàn chân, ny=1 đỉnh đầu.
// 8-head landmarks (từ dưới lên):
//   knee ≈0.25 | crotch/groin ≈0.50 | ASIS(hip bone) ≈0.53 | navel ≈0.625 | nipple ≈0.75 | chin ≈0.875
// Ngưỡng dọc:  head>0.875 | neck>0.813 | chest>0.660 | abdomen>0.520
//              pelvis>0.420 | thigh>0.220 | lower_leg≥0
// Ngưỡng ngang: arm nx>0.52 | shoulder nx>0.30 (vùng ngực trở lên)

function classifyByPosition(point: THREE.Vector3, bbox: THREE.Box3): string {
  const size   = new THREE.Vector3();
  const center = new THREE.Vector3();
  bbox.getSize(size);
  bbox.getCenter(center);

  const ny = Math.max(0, Math.min(1, (point.y - bbox.min.y) / size.y));
  const dx = point.x - center.x;
  const nx = Math.abs(dx) / (size.x * 0.5);

  console.log(`[CLICK] ny=${ny.toFixed(3)} nx=${nx.toFixed(3)} dx=${dx.toFixed(3)}`);

  if (nx > 0.52) {
    const r = dx < 0 ? 'left_arm' : 'right_arm';
    console.log(`[CLICK] → ${r} (arm)`); return r;
  }
  // Vai chỉ ở vùng ngực trở lên (ny > 0.660)
  if (nx > 0.30 && ny > 0.660) {
    const r = dx < 0 ? 'left_shoulder' : 'right_shoulder';
    console.log(`[CLICK] → ${r} (shoulder)`); return r;
  }
  if (ny > 0.875) { console.log('[CLICK] → head');    return 'head'; }
  if (ny > 0.813) { console.log('[CLICK] → neck');    return 'neck'; }
  // chest = từ núm vú tới cổ (ny 0.660–0.813)
  if (ny > 0.660) { console.log('[CLICK] → chest');   return 'chest'; }
  // abdomen = vùng rốn/bụng — từ dưới xương sườn tới đỉnh xương chậu (ny 0.520–0.660)
  if (ny > 0.520) { console.log('[CLICK] → abdomen'); return 'abdomen'; }
  // pelvis = hông/khung chậu — xương hông, bẹn, xương mu (ny 0.420–0.520)
  if (ny > 0.420) { console.log('[CLICK] → pelvis');  return 'pelvis'; }
  // thigh = đùi — từ dưới hông tới đầu gối (ny 0.220–0.420)
  if (ny > 0.220) {
    const r = dx < -0.01 ? 'left_leg' : 'right_leg';
    console.log(`[CLICK] → ${r} (thigh)`); return r;
  }
  // lower leg = cẳng chân — bắp chân, xương chày (ny 0.075–0.220)
  if (ny > 0.075) {
    const r = dx < -0.01 ? 'left_lower_leg' : 'right_lower_leg';
    console.log(`[CLICK] → ${r} (lower leg)`); return r;
  }
  // foot = bàn chân — mắt cá, bàn chân, ngón chân (ny 0–0.075)
  const r = dx < -0.01 ? 'left_foot' : 'right_foot';
  console.log(`[CLICK] → ${r} (foot)`); return r;
}

// Thử tên mesh trước, nếu không có thì dùng vị trí
function classifyMesh(point: THREE.Vector3, bbox: THREE.Box3, object?: THREE.Object3D): string {
  if (object) {
    const byName = classifyByMeshName(object);
    if (byName) { console.log(`[CLICK] → ${byName} (mesh name: "${object.name}")`); return byName; }
  }
  return classifyByPosition(point, bbox);
}

// ── Vòng tròn nhấp nháy (thoát từ tâm ra ngoài) ──────────────────────────────

function PulseRing({ color, delay }: { color: number; delay: number }) {
  const meshRef = useRef<THREE.Mesh>(null!);
  const matRef  = useRef<THREE.MeshBasicMaterial>(null!);
  const t       = useRef(delay);

  useFrame((_, delta) => {
    t.current = (t.current + delta * 0.85) % 1;
    if (meshRef.current) meshRef.current.scale.setScalar(0.02 + t.current * 0.14);
    if (matRef.current)  matRef.current.opacity = Math.max(0, (1 - t.current) * 0.88);
  });

  return (
    <mesh ref={meshRef}>
      <ringGeometry args={[0.78, 1.0, 40]} />
      <meshBasicMaterial
        ref={matRef}
        color={new THREE.Color(color)}
        transparent
        depthTest={false}
        side={THREE.DoubleSide}
      />
    </mesh>
  );
}

// ── GLB model loader + click detection ───────────────────────────────────────

function GltfHuman({
  selected,
  onSelect,
  onHover,
}: {
  selected: string | null;
  onSelect: (id: string) => void;
  onHover:  (id: string | null) => void;
}) {
  const gltf     = useGLTF('/models/body_male.glb');
  const scene    = gltf.scene ?? gltf.scenes?.[0];
  const groupRef = useRef<THREE.Group>(null!);
  const bboxRef  = useRef<THREE.Box3>(new THREE.Box3());
  const readyRef = useRef(false);
  // Lưu hệ số scale để bù khi render marker trong local space
  const scaleRef = useRef(1);

  const [markerLocalPos, setMarkerLocalPos] = useState<THREE.Vector3 | null>(null);
  const [markerColor,    setMarkerColor]    = useState<number>(0x4a7c96);

  useEffect(() => {
    if (!scene) return;
    scene.updateMatrixWorld(true);

    const box    = new THREE.Box3().setFromObject(scene);
    const size   = new THREE.Vector3();
    const center = new THREE.Vector3();
    box.getSize(size);
    box.getCenter(center);

    const maxDim = Math.max(size.x, size.y, size.z);
    const s      = maxDim > 0 ? 2.0 / maxDim : 1;
    scaleRef.current = s;

    if (groupRef.current) {
      groupRef.current.scale.setScalar(s);
      groupRef.current.position.set(-center.x * s, -center.y * s, -center.z * s);
    }

    bboxRef.current.copy(new THREE.Box3(
      new THREE.Vector3((box.min.x - center.x) * s, (box.min.y - center.y) * s, (box.min.z - center.z) * s),
      new THREE.Vector3((box.max.x - center.x) * s, (box.max.y - center.y) * s, (box.max.z - center.z) * s),
    ));

    readyRef.current = true;
  }, [scene]);

  useEffect(() => {
    if (!selected) setMarkerLocalPos(null);
  }, [selected]);

  if (!scene) return null;

  return (
    <group ref={groupRef}>
      <primitive
        object={scene}
        onClick={(e: ThreeEvent<MouseEvent>) => {
          e.stopPropagation();
          if (!readyRef.current || !e.object) return;

          const part = classifyMesh(e.point, bboxRef.current, e.object);
          const localPoint = groupRef.current.worldToLocal(e.point.clone());
          setMarkerLocalPos(localPoint);
          setMarkerColor(PART_COLORS[part] ?? 0x4a7c96);
          onSelect(part);
        }}
        onPointerOver={(e: ThreeEvent<PointerEvent>) => {
          e.stopPropagation();
          if (!readyRef.current) {
            document.body.style.cursor = 'default';
            return;
          }
          onHover(classifyMesh(e.point, bboxRef.current, e.object));
          document.body.style.cursor = 'pointer';
        }}
        onPointerOut={() => {
          onHover(null);
          document.body.style.cursor = 'default';
        }}
      />

      {/* Marker trong LOCAL SPACE của group → luôn gắn với model */}
      {markerLocalPos && (
        <Billboard position={markerLocalPos}>
          {/* scale={1/s} bù lại group scale để kích thước world-space không đổi */}
          <group scale={1 / scaleRef.current}>
            <mesh renderOrder={1000}>
              <circleGeometry args={[0.034, 40]} />
              <meshBasicMaterial color="white" depthTest={false} />
            </mesh>
            <mesh renderOrder={1001}>
              <circleGeometry args={[0.024, 40]} />
              <meshBasicMaterial color={new THREE.Color(markerColor)} depthTest={false} />
            </mesh>
            <mesh renderOrder={1002}>
              <circleGeometry args={[0.008, 20]} />
              <meshBasicMaterial color="white" depthTest={false} />
            </mesh>
            <PulseRing color={markerColor} delay={0.0} />
            <PulseRing color={markerColor} delay={0.5} />
          </group>
        </Billboard>
      )}
    </group>
  );
}

// ── Fallback: holographic geometry (dùng khi chưa có human.glb) ──────────────

type GeoType = 'sphere' | 'box' | 'cylinder' | 'capsule';
interface PartDef { id: string; geo: GeoType; args: number[]; pos: [number,number,number]; rot?: [number,number,number]; }
const PARTS: PartDef[] = [
  { id:'head',           geo:'sphere',  args:[0.210,40,40],           pos:[0,     1.800, 0    ] },
  { id:'neck',           geo:'capsule', args:[0.082,0.145,8,14],      pos:[0,     1.520, 0    ] },
  { id:'chest',          geo:'box',     args:[0.800,0.480,0.310],     pos:[0,     1.085, 0    ] },
  { id:'chest',          geo:'box',     args:[0.710,0.150,0.285],     pos:[0,     0.800, 0    ] },
  { id:'abdomen',        geo:'box',     args:[0.600,0.270,0.245],     pos:[0,     0.585, 0    ] },
  { id:'pelvis',         geo:'box',     args:[0.740,0.350,0.295],     pos:[0,     0.230, 0    ] },
  { id:'left_shoulder',  geo:'sphere',  args:[0.158,24,24],           pos:[-0.546,1.170, 0    ] },
  { id:'right_shoulder', geo:'sphere',  args:[0.158,24,24],           pos:[ 0.546,1.170, 0    ] },
  { id:'left_arm',       geo:'capsule', args:[0.087,0.440,6,14],      pos:[-0.745,0.812, 0    ], rot:[0,0, 0.130] },
  { id:'right_arm',      geo:'capsule', args:[0.087,0.440,6,14],      pos:[ 0.745,0.812, 0    ], rot:[0,0,-0.130] },
  { id:'left_arm',       geo:'capsule', args:[0.072,0.410,6,12],      pos:[-0.878,0.125, 0.010], rot:[0.04,0, 0.060] },
  { id:'right_arm',      geo:'capsule', args:[0.072,0.410,6,12],      pos:[ 0.878,0.125, 0.010], rot:[0.04,0,-0.060] },
  { id:'left_leg',             geo:'capsule', args:[0.135,0.600,6,16],  pos:[-0.210,-0.260, 0   ] },
  { id:'right_leg',            geo:'capsule', args:[0.135,0.600,6,16],  pos:[ 0.210,-0.260, 0   ] },
  { id:'left_lower_leg',       geo:'capsule', args:[0.090,0.430,6,14],  pos:[-0.210,-1.010, 0   ] },
  { id:'right_lower_leg',      geo:'capsule', args:[0.090,0.430,6,14],  pos:[ 0.210,-1.010, 0   ] },
  { id:'left_foot',            geo:'box',     args:[0.155,0.092,0.350], pos:[-0.210,-1.370,0.110] },
  { id:'right_foot',           geo:'box',     args:[0.155,0.092,0.350], pos:[ 0.210,-1.370,0.110] },
];

function Geo({ geo, args }: { geo: GeoType; args: number[] }) {
  if (geo === 'sphere')  return <sphereGeometry   args={args as [number,number,number]} />;
  if (geo === 'box')     return <boxGeometry       args={args as [number,number,number]} />;
  if (geo === 'capsule') return <capsuleGeometry   args={args as [number,number,number,number]} />;
  return null;
}

function HoloPart({ part, selected, hovered, onSelect, onHover }: {
  part: PartDef; selected: string|null; hovered: string|null;
  onSelect:(id:string)=>void; onHover:(id:string|null)=>void;
}) {
  const isSel = selected === part.id;
  const isHov = hovered  === part.id && !isSel;
  return (
    <group position={part.pos} rotation={part.rot ?? [0,0,0]}>
      <mesh
        castShadow
        onClick={(e) => { e.stopPropagation(); onSelect(part.id); }}
        onPointerOver={(e) => { e.stopPropagation(); onHover(part.id); document.body.style.cursor='pointer'; }}
        onPointerOut={() => { onHover(null); document.body.style.cursor='default'; }}
      >
        <Geo geo={part.geo} args={part.args} />
        <meshPhysicalMaterial
          color={isSel ? '#2d8fff' : isHov ? '#1358c8' : '#07194d'}
          emissive={isSel ? '#60c8ff' : isHov ? '#2266ee' : '#0c38b8'}
          emissiveIntensity={isSel ? 1.4 : isHov ? 0.85 : 0.5}
          transparent opacity={isSel ? 0.96 : isHov ? 0.93 : 0.88}
          roughness={0.18} metalness={0.08}
        />
      </mesh>
      <mesh scale={[1.058,1.058,1.058]}>
        <Geo geo={part.geo} args={part.args} />
        <meshPhysicalMaterial
          color="#0066cc"
          emissive={isSel ? '#aaddff' : isHov ? '#44aaff' : '#0088ee'}
          emissiveIntensity={isSel ? 5.0 : isHov ? 3.5 : 2.2}
          transparent opacity={isSel ? 0.72 : isHov ? 0.58 : 0.42}
          roughness={0} side={THREE.BackSide}
        />
      </mesh>
    </group>
  );
}

function HoloBody({ selected, hovered, onSelect, onHover }: {
  selected:string|null; hovered:string|null;
  onSelect:(id:string)=>void; onHover:(id:string|null)=>void;
}) {
  return (
    <group>
      {PARTS.map((part, i) => (
        <HoloPart key={`${part.id}-${i}`} part={part} selected={selected} hovered={hovered} onSelect={onSelect} onHover={onHover} />
      ))}
    </group>
  );
}

// ── Loader fallback UI ────────────────────────────────────────────────────────

function CanvasLoader() {
  return (
    <div className="w-full h-full flex items-center justify-center bg-slate-950">
      <div className="text-center text-slate-400">
        <div className="text-4xl mb-3 animate-pulse">🫀</div>
        <p className="text-sm">Đang tải mô hình 3D...</p>
      </div>
    </div>
  );
}

// ── GLB availability check ────────────────────────────────────────────────────
// Fallback to HoloBody (interactive hotspots) with 3 second timeout

function useHasGlb() {
  const [has, setHas] = useState<boolean | null>(false); // Default: false (use HoloBody)
  useEffect(() => {
    let timeout: NodeJS.Timeout;
    
    const checkGlb = async () => {
      try {
        timeout = setTimeout(() => setHas(false), 3000); // 3 sec timeout → fallback
        const res = await fetch('/models/body_male.glb', { method: 'HEAD' });
        clearTimeout(timeout);
        setHas(res.ok);
      } catch {
        clearTimeout(timeout);
        setHas(false); // Fallback on error
      }
    };
    
    checkGlb();
    return () => clearTimeout(timeout);
  }, []);
  return has;
}

// ── Scene wrapper ─────────────────────────────────────────────────────────────

function Scene({
  useGlb, selected, hovered, onSelect, onHover,
}: {
  useGlb: boolean;
  selected: string|null; hovered: string|null;
  onSelect:(id:string)=>void; onHover:(id:string|null)=>void;
}) {
  return (
    <>
      {useGlb ? (
        <>
          <ambientLight intensity={0.6} color="#fff8f0" />
          <directionalLight position={[3, 8, 5]}  intensity={1.2} color="#ffffff" castShadow />
          <directionalLight position={[-4, 4, -3]} intensity={0.5} color="#cce4ff" />
          <pointLight       position={[0, 3, -4]}  intensity={0.4} color="#ffddcc" />
          <Environment preset="studio" backgroundIntensity={0.1} />
          <GltfHuman selected={selected} onSelect={onSelect} onHover={onHover} />
        </>
      ) : (
        <>
          <ambientLight intensity={0.12} color="#2244aa" />
          <directionalLight position={[2,6,4]}   intensity={0.55} color="#4488ff" />
          <directionalLight position={[-3,4,-3]} intensity={0.25} color="#224488" />
          <pointLight       position={[0,2,-5]}  intensity={0.6}  color="#0055cc" />
          <gridHelper args={[14,28,'#0a1e40','#06132a']} position={[0,-1.52,0]} />
          <HoloBody selected={selected} hovered={hovered} onSelect={onSelect} onHover={onHover} />
        </>
      )}
    </>
  );
}

// ── Main export ───────────────────────────────────────────────────────────────

export default function BodyViewer3D({
  selected,
  onSelect,
}: {
  selected: string | null;
  onSelect: (id: string) => void;
}) {
  const [hovered, setHovered] = useState<string | null>(null);
  const hasGlb = useHasGlb();

  return (
    <Canvas shadows camera={{ fov: 45, near: 0.1, far: 100, position: [0, 0, 4.5] }}>
      <color attach="background" args={['#0d1117']} />

      <Suspense fallback={null}>
        <Scene
          useGlb={hasGlb === true}
          selected={selected}
          hovered={hovered}
          onSelect={onSelect}
          onHover={setHovered}
        />
      </Suspense>

      <OrbitControls
        enablePan
        panSpeed={0.8}
        minDistance={3}
        maxDistance={8}
        target={[0, 0, 0]}
        enableDamping
        dampingFactor={0.08}
      />
    </Canvas>
  );
}
